{
	"name": "@adbayb/stack",
	"version": "3.5.3",
	"description": "My opinionated JavaScript-based toolchain",
	"keywords": [
		"development",
		"scripts",
		"stack",
		"toolchain"
	],
	"license": "MIT",
	"author": {
		"name": "Ayoub Adib",
		"email": "adbayb@gmail.com",
		"url": "https://twitter.com/adbayb"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/adbayb/stack.git",
		"directory": "stack"
	},
	"bin": {
		"stack": "./bin/index.js"
	},
	"files": [
		"bin",
		"configs",
		"dist",
		"skills",
		"templates"
	],
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./oxfmt": {
			"source": "./configs/oxfmt/index.ts",
			"types": "./dist/configs/oxfmt.d.ts",
			"default": "./dist/configs/oxfmt.js"
		},
		"./oxlint": {
			"source": "./configs/oxlint/index.ts",
			"types": "./dist/configs/oxlint.d.ts",
			"default": "./dist/configs/oxlint.js"
		},
		"./typescript": "./configs/typescript/index.json"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "quickbundle build",
		"prepublishOnly": "pnpm build",
		"prestart": "pnpm build",
		"start": "./bin/index.js",
		"test": "vitest run",
		"watch": "quickbundle watch"
	},
	"dependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@e18e/eslint-plugin": "^0.8.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint-plugin-perfectionist": "^5.13.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"termost": "^2.0.0",
		"turbo": "^2.11.10",
		"typescript": "^7.0.2"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"quickbundle": "3.2.2",
		"vitest": "5.0.5"
	}
}
